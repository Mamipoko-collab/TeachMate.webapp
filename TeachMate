@app.route("/register", methods=["POST"])
def register_user():
    data = request.get_json(silent=True)
    if not data:
        return jsonify({"error": "Invalid JSON payload"}), 400

    name = (data.get("name") or "").strip()
    if not name:
        return jsonify({"error": "Missing required parameter: name"}), 400

    if len(name) > 50:
        return jsonify({"error": "Name must be 50 characters or fewer"}), 400

    normalized_name = normalize_name(name)
    name_key = make_name_key(normalized_name)
    name_index_ref = db.reference(f"user_name_index/{name_key}")

    if name_index_ref.get():
        return jsonify({
            "status": "error",
            "message": "This name is already registered",
        }), 409

    created_at = datetime.utcnow().isoformat()
    user_ref = db.reference("users").push({
        "name": name,
        "normalized_name": normalized_name,
        "created_at": created_at,
    })

    user_id = user_ref.key
    name_index_ref.set({
        "user_id": user_id,
        "name": name,
        "created_at": created_at,
    })

    return jsonify({
        "status": "success",
        "message": "User registered successfully",
        "user": {
            "id": user_id,
            "name": name,
            "created_at": created_at,
        },
    }), 201


